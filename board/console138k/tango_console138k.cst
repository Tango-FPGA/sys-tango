// The constraint statements are Gowin's syntax (SUG1018 Arora V Design Physical Constraints User Guide).
// tango_sys_top138 (every Console 138K Tango core) on the Tang Console 138K (GW5AST-LV138PG484AC1/I0).
// clk + HDMI (silicon-proven).
IO_LOC "clk" V22; IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "tmds_clk_p" G15; IO_PORT "tmds_clk_p" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_clk_n" G16; IO_PORT "tmds_clk_n" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[0]" J14; IO_PORT "tmds_d_p[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[0]" H14; IO_PORT "tmds_d_n[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[1]" J15; IO_PORT "tmds_d_p[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[1]" H15; IO_PORT "tmds_d_n[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[2]" K17; IO_PORT "tmds_d_p[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[2]" J17; IO_PORT "tmds_d_n[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;

// ---- BL616 link ---------------------------------------------------------------------------------------------------
// Ball locations: Sipeed's Tang Console 138K schematic (Tang_Mega_138K_Console_32001C, Rev 1.3; NOTICE) and Gowin's
// GW5AST-138B PBGA484A pin file.
// The SPI link to the BL616 uses the FPGA's four JTAG balls (bank 10; CFG TMS / TCK / TDI / TDO in the PBGA484A pin
// file), which the BL616 also drives as JTAG when it programs the FPGA, and two bank-5 balls on the BL616's UART pins.
// The JTAG balls are user I/O after configuration because the build sets -use_jtag_as_gpio 1 (UG290-2.7.6E Table 4-2,
// JTAG PORT "Set as GPIO").  Schematic nets: SOM_BTB0 (JTAG.*), SOM_BTB2 (FPGA_UART.*, LCD.INT2), USB_JTAG (BL616 side).
// IO_TYPE LVCMOS33, BANK_VCCIO 3.3: VCCIO10 and VCCIO5 are on the 3.3 V rail (sheet POWER_TREE).
// Inputs: a pull only where the line can be left undriven (BL616 in reset or booting) and must then read a defined
// level, and none against a resistor on the board.
//
// spi_csn: T13 = JTAG.TMS = BL616 GPIO_0, input, the link's select (active low).  Pull-up: undriven, the link is
// deselected.
IO_LOC  "spi_csn" T13;
IO_PORT "spi_csn" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// spi_sck: V12 = JTAG.TCK = BL616 GPIO_1, input, the link's bit clock.  No pull: Gowin requires a 4.7 kOhm pull-down on
// TCK on the PCB (UG290-2.7.6E Table 7-3 note 2; on the SOM, not on the Console schematic).  DRIVE=OFF: input only.
IO_LOC  "spi_sck" V12;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
// The SCK domain (tango_link) is clocked by spi_sck_clk, an internal net equal to spi_sck (CLOCK_LOC names a net, not a
// port: tango_sys_top138.v), put on a global clock line (SUG1018 CLOCK_LOC, BUFG = CLK) so that every flop of the domain
// gets the edge through the low-skew clock tree rather than general routing.
CLOCK_LOC "spi_sck_clk" BUFG = CLK;
// spi_mosi: R13 = JTAG.TDI = BL616 GPIO_3, input.  No pull: the BL616 drives it whenever the link runs (when it does
// not, spi_csn's pull-up keeps the link deselected).  DRIVE=OFF: input only.
IO_LOC  "spi_mosi" R13;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
// spi_miso: U13 = JTAG.TDO = BL616 GPIO_2, driven by the FPGA (an inout only so that the pad can be read back for debug).
// No pull: the board pulls the net down with 3.3 kOhm (R73 0 Ohm to BL616_BOOT, R72 3.3 kOhm to ground; sheet USB_JTAG),
// which an internal pull-up would fight.  DRIVE=8 mA: far above the 1 mA that pull-down draws at 3.3 V.
IO_LOC  "spi_miso" U13;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// spi_irqn: U15 = FPGA_UART.TX -> BL616_IO27_RX (R76 3 Ohm), output, the link's interrupt (active low).  No pull: the FPGA
// always drives it.  DRIVE=8 mA, as spi_miso.
IO_LOC  "spi_irqn" U15;
IO_PORT "spi_irqn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// bl616_jtagsel: V14 = FPGA_UART.RX <- BL616_IO28_TX (R75 3 Ohm), input.  The BL616 sets it high to take the JTAG balls
// back for programming (jtagseln below).  Pull-up: while the BL616 does not drive it, it reads high and the JTAG balls
// stay available for programming.
IO_LOC  "bl616_jtagsel" V14;
IO_PORT "bl616_jtagsel" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// jtagseln = NOT bl616_jtagsel (tango_sys_top138.v): the JTAGSEL_N function driven from logic.  NET_LOC ... V_JTAGSELN
// (SUG1018-1.6E 2.10.2, JTAGSEL_N Net Constraints) gives a net control of JTAGSEL_N; JTAGSEL_N low returns the JTAG
// balls to configuration (UG290-2.7.6E Table 4-2), so a running core can be reprogrammed without a power cycle.
// The PBGA484A package has no JTAGSEL_N ball.  Place and route also puts the port on a user I/O; IO_LOC fixes that at
// T16 (IOB76A, bank 5: the SOM connector's LCD.INT2 net, sheet SOM_BTB2) so that every build has the same pins.
// PULL_MODE=DOWN: the low (asserting) level whenever the output is not driven.
NET_LOC "jtagseln" V_JTAGSELN;
IO_PORT "jtagseln" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "jtagseln" T16;

// USB-A host ports (Sipeed Tang_Mega_138K_Console_32001C schematic, "2 x USB-A": FPGA_USB1_P/N = M15/M16,
// FPGA_USB2_P/N = H13/G13, bank 3, 15k pull-downs on the board, VBUS always on).
IO_LOC "usb1_dp" M15; IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "usb1_dn" M16; IO_PORT "usb1_dn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "usb2_dp" H13; IO_PORT "usb2_dp" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "usb2_dn" G13; IO_PORT "usb2_dn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
