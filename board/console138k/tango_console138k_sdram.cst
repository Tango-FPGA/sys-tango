// tango_console138k_sdram.cst -- the Console 138K SDRAM module's pins, appended to the board cst by
// build_core.sh for TANGO_SDRAM=1 cores (ports: sys/tango_sdram_ports.vh, MiSTer emu SDRAM_* names).
// Ball map from two sources that agree on all 38 pins:
//   nand2mario/nestang 5b24a71 src/boards/console.cst (IO_sdram_dq / O_sdram_addr / O_sdram_ba /
//   O_sdram_dqm / O_sdram_clk / _wen_n / _ras_n / _cas_n / _cs_n F21 "was F19 on mega60k");
//   the constraints of our own SDRAM march test on this board (0 errors on silicon).  No CKE ball on either
//   (tied on the module).  DQML = dqm[0], DQMH = dqm[1].
// LVCMOS33 as both sources.
IO_LOC "SDRAM_CLK" B17;
IO_PORT "SDRAM_CLK" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nCS" F21;
IO_PORT "SDRAM_nCS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nRAS" F16;
IO_PORT "SDRAM_nRAS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nCAS" E17;
IO_PORT "SDRAM_nCAS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nWE" D16;
IO_PORT "SDRAM_nWE" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_BA[0]" F15;
IO_PORT "SDRAM_BA[0]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_BA[1]" C20;
IO_PORT "SDRAM_BA[1]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQML" F14;
IO_PORT "SDRAM_DQML" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQMH" F13;
IO_PORT "SDRAM_DQMH" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[0]" D19;
IO_PORT "SDRAM_A[0]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[1]" E19;
IO_PORT "SDRAM_A[1]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[2]" C19;
IO_PORT "SDRAM_A[2]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[3]" C18;
IO_PORT "SDRAM_A[3]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[4]" E16;
IO_PORT "SDRAM_A[4]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[5]" D15;
IO_PORT "SDRAM_A[5]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[6]" D14;
IO_PORT "SDRAM_A[6]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[7]" A19;
IO_PORT "SDRAM_A[7]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[8]" A18;
IO_PORT "SDRAM_A[8]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[9]" C17;
IO_PORT "SDRAM_A[9]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[10]" D20;
IO_PORT "SDRAM_A[10]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[11]" D17;
IO_PORT "SDRAM_A[11]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[12]" B18;
IO_PORT "SDRAM_A[12]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[0]" E14;
IO_PORT "SDRAM_DQ[0]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[1]" E13;
IO_PORT "SDRAM_DQ[1]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[2]" C15;
IO_PORT "SDRAM_DQ[2]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[3]" C14;
IO_PORT "SDRAM_DQ[3]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[4]" B13;
IO_PORT "SDRAM_DQ[4]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[5]" C13;
IO_PORT "SDRAM_DQ[5]" IO_TYPE=LVCMOS33;
