IO_LOC "SDRAM_DQ[7]" A13;
IO_PORT "SDRAM_DQ[7]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQ[8]" B21;
IO_PORT "SDRAM_DQ[8]" IO_TYPE=LVCMOS33;
