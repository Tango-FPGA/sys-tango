// tango_console138k_sdram.cst -- the Console 138K SDRAM module's pins, appended to the board cst by
// build_core.sh for TANGO_SDRAM=1 cores (ports: sys/tango_sdram_ports.vh, MiSTer emu SDRAM_* names).
// Ball map: Sipeed's Tang Console 138K schematic, Tang_Mega_138K_Console_32001C__Schematics.pdf ("Tang_138K_Console_
// V32001C", Rev 1.3; https://dl.sipeed.com/shareURL/TANG/Console/02_Schematic), the SDRAM0_* nets of
// sheets SOM_BTB1 (p5) and FPGA_EXT_CONN (p8), and SOM_BTB0 (p4) for SDRAM0_~{CS} = F21: CLK B17, ~{CS} F21,
// ~{RAS} F16, ~{CAS} E17, ~{WE} D16, BA0-1, A0-12, D0-15 and DM0 / DM1 (= DQML / DQMH below).  The document states
// no licence or terms of use.  No CKE ball (tied on the module).  LVCMOS33: bank 2 runs at 3.3 V (VCCIO2 from the
// 3.3 V rail, sheet POWER_TREE, p2).  nestang's console.cst (nand2mario/nestang 5b24a71) and the constraints of our
// own SDRAM march test on this board name the same 38 balls; they are earlier references, not the source.
IO_LOC "SDRAM_CLK" B17;
IO_PORT "SDRAM_CLK" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nCS" F21;
IO_PORT "SDRAM_nCS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nRAS" F16;
IO_PORT "SDRAM_nRAS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nCAS" E17;
IO_PORT "SDRAM_nCAS" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_nWE" D16;
IO_PORT "SDRAM_nWE" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_BA[0]" F15;
IO_PORT "SDRAM_BA[0]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_BA[1]" C20;
IO_PORT "SDRAM_BA[1]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQML" F14;
IO_PORT "SDRAM_DQML" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_DQMH" F13;
IO_PORT "SDRAM_DQMH" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[0]" D19;
IO_PORT "SDRAM_A[0]" IO_TYPE=LVCMOS33;
IO_LOC "SDRAM_A[1]" E19;
