// tango_cfg.vh -- build options of the framework, as `defines.  This file defines nothing (a core without
// SDRAM); an option is defined BEFORE it: build_core.sh TANGO_SDRAM=1 compiles a generated tango_defines.v
// with `define TANGO_SDRAM first, a Verilator sim passes +define+TANGO_SDRAM.
//   TANGO_SDRAM  the core has the SDRAM ports (tango_sdram_ports.vh) and the SDRAM module's pins are
//                constrained (sys/board/console138k/tango_console138k_sdram.cst).
//   TANGO_SD     the core has MiSTer's block-device ports (tango_sd_ports.vh); TANGO_SD_VDNUM drives (1-4)
//   TANGO_IOCTL_UPLOAD  the core has MiSTer's hps_io upload direction (ioctl_upload, ioctl_upload_req,
//                ioctl_upload_index, ioctl_din, ioctl_rd -- hps_io.sv 142-150), the reverse of ioctl_download:
//                reading a blob back from the core (DIP/cheat send and NVRAM load reuse ioctl_download
//                unchanged at a new index; this is only for NVRAM save).
//   TANGO_VIDEO_FB  the core outputs MiSTer's emu video ports (CLK_VIDEO, CE_PIXEL, VGA_*, VIDEO_ARX/ARY...) and
//                the framework's frame buffer + scaler (tango_video.v) puts them on the 720p screen, instead of
//                the core colouring the 720p beam (VID_CX/VID_CY/VID_RGB).  Sized per core:
//                TANGO_VIDEO_MAXW / _MAXH (largest active picture), _BPC (4/5/6/8 bits per colour),
//                _NBUF (3 triple, 2 double).  TANGO_VIDEO_IDX: index mode, TANGO_VIDEO_IDXW (1-12) bits stored per
//                pixel (VGA_IDX) and a 2^IDXW x 24 palette the core writes (VIDEO_PAL_*); else RGB is stored
`ifndef TANGO_SD_VDNUM
`define TANGO_SD_VDNUM 1
`endif
`ifndef TANGO_VIDEO_MAXW
`define TANGO_VIDEO_MAXW 256
`endif
`ifndef TANGO_VIDEO_MAXH
`define TANGO_VIDEO_MAXH 240
`endif
`ifndef TANGO_VIDEO_BPC
`define TANGO_VIDEO_BPC 8
`endif
`ifndef TANGO_VIDEO_NBUF
`define TANGO_VIDEO_NBUF 3
`endif
`ifndef TANGO_VIDEO_IDXW
`define TANGO_VIDEO_IDXW 8
`endif

// TANGO_VIDEO_ASCAL: replace the BSRAM frame buffer with TEMLIB ascal.vhd + SDRAM.
// tango_sdram.v owns the SDRAM pins; the core must NOT define TANGO_SDRAM (unless TANGO_ASCAL_EXT, below).
// TANGO_VIDEO_FB and TANGO_VIDEO_ASCAL are mutually exclusive.
// `define TANGO_VIDEO_ASCAL
// TANGO_ASCAL_EXT (with TANGO_VIDEO_ASCAL and TANGO_SDRAM): the core owns the SDRAM and its controller (MiSTer-style,
// TANGO_SDRAM), and that controller serves ascal's Avalon MM master too: tango_core_ports.vh gives the core ascal's
// Avalon port (ascal_avl_*) and the core says which clock ascal's Avalon side runs on (ASCAL_AVL_CLK, the core's memory
// clock).  No tango_sdram and no SDRAM PLL are built.  The window is the same as with tango_sdram: three frame buffers
// of TANGO_VIDEO_ASCAL_RAMSIZE from TANGO_VIDEO_ASCAL_RAMBASE (below; the GHDL netlist bakes both in), i.e. SDRAM
// banks 2/3 -- the core keeps its own data out of them.  The protocol ascal's master uses is the one tango_sdram's
// port C serves; tango_ascal_words.v turns it into 16-bit word accesses for a core's controller (README "A core that
// owns the SDRAM").
// build_core.sh TANGO_ASCAL_EXT=1; sims +define+TANGO_ASCAL_EXT.  Not defined: every build is as before.
// TANGO_VIDEO_F1 (with TANGO_VIDEO_ASCAL): the core drives MiSTer's VGA_F1, the interlace field (emu port; MiSTer's
// sys_top.v passes it to ascal's i_fl), so ascal detects interlaced video and weaves the two fields into one frame as on
// MiSTer; and the framework's Scanlines (TANGO_VIDEO_OPTS) are off while the input is interlaced, as MiSTer cores mask
// VGA_SL in interlace themselves (Genesis_MiSTer Genesis.sv 697).  Not defined: ascal's i_fl is 0, as before.
// TANGO_VIDEO_DDR3 (with TANGO_VIDEO_ASCAL; excludes TANGO_ASCAL_EXT and TANGO_SIM): ascal's frames in
// the DDR3 (README "The DDR3 path"): tango_ddr3's scaler port (128-bit Avalon, MiSTer's N_DW / N_AW; the GHDL netlists
// ascal_ghdl/ascal_fixed{,8}_ddr3.v) in the DDR3 IP's clk_out; the board top has the IP (generated by the build), its
// PLL at PLL_L[0] and the pins.  RAMBASE defaults to 0x2000_0000, the scaler's DDR3 window.  No tango_sdram is built
// (a core keeps the SDRAM through TANGO_SDRAM) -- except with TANGO_NES_SDRAM: tango_sdram then serves the NES's ports
// A/B alone (port C idle), with its PLL and pins as before.  build_core.sh TANGO_VIDEO_DDR3=1.  Not defined: every
// build is as before.
// TANGO_FW_SDRAM (derived here, never set by a build): the framework's tango_sdram, its PLL (Gowin_PLL_SDRAM) and
// its pins are built -- every TANGO_VIDEO_ASCAL build without TANGO_ASCAL_EXT whose frames are in the SDRAM (port C =
// ascal), and TANGO_VIDEO_DDR3 + TANGO_NES_SDRAM (ports A/B only)
`ifdef TANGO_VIDEO_ASCAL
`ifndef TANGO_ASCAL_EXT
`ifndef TANGO_VIDEO_DDR3
`ifndef TANGO_FW_SDRAM
`define TANGO_FW_SDRAM
`endif
`elsif TANGO_NES_SDRAM
`ifndef TANGO_FW_SDRAM
`define TANGO_FW_SDRAM
`endif
`endif
`endif
`endif
// Frame dimensions for ascal sizing:
`ifndef TANGO_VIDEO_ASCAL_MAXW
`define TANGO_VIDEO_ASCAL_MAXW 256
`endif
`ifndef TANGO_VIDEO_ASCAL_MAXH
`define TANGO_VIDEO_ASCAL_MAXH 240
`endif
// SDRAM region reserved for ascal frame buffers (20 MB mark, 4 MB/buf × 3 bufs = 12 MB, fits 32 MB SDRAM):
`ifndef TANGO_VIDEO_ASCAL_RAMBASE
`ifdef TANGO_VIDEO_DDR3
`define TANGO_VIDEO_ASCAL_RAMBASE 32'h2000_0000      // TANGO_VIDEO_DDR3: the scaler's DDR3 window
`else
`define TANGO_VIDEO_ASCAL_RAMBASE 32'h0140_0000
`endif
`endif
`ifndef TANGO_VIDEO_ASCAL_RAMSIZE
`define TANGO_VIDEO_ASCAL_RAMSIZE 32'h0040_0000
`endif

// TANGO_VIDEO_ROTATE (with TANGO_VIDEO_ASCAL; build_core.sh also requires TANGO_VIDEO_DDR3 and sets TANGO_DDRAM):
// screen rotation (README "Rotation").  tango_sys.v instantiates tango_video_rotate_ddr3.v, which writes the core's
// picture rotated into the DDR3 through tango_ddr3's core port C0; ascal's frame-buffer read (o_fb_*) shows it.
// rotate_mode is CDC'd from status[`TANGO_VO_B_ROTATE] (tango_cdc_word, clk_pix -> clk_video, in tango_sys.v), not
// a literal: a constant 2'b00 would let GowinSynthesis prove the block unused and constant-fold it away, so a
// build's numbers would describe an absent block.  `TANGO_VIDEO_CONF`/`TANGO_VIDEO_CONF_P` (tango_video_opts.vh)
// add the Rotate entry ONLY when TANGO_VIDEO_ROTATE itself is defined for the build -- a core that defines
// TANGO_VIDEO_OPTS without TANGO_VIDEO_ROTATE (every console-style core) still gets no entry and no firmware sets
// these bits for it.  In Normal, ascal shows its own input as without the option.
// build_core.sh TANGO_VIDEO_ROTATE=1 (needs TANGO_VIDEO_ASCAL=1, checked there like TANGO_VIDEO_OPTS is).
// Not defined: tango_sys.v does not instantiate the rotation client at all -- a core that never sets this
// flag gets the exact, unchanged netlist it had before this option existed.
`ifdef TANGO_VIDEO_ROTATE
`ifndef TANGO_VIDEO_ASCAL
tango_video_rotate_needs_TANGO_VIDEO_ASCAL
`endif
`endif

// TANGO_NES_SDRAM: expose tango_sdram's NES-compatible port A (PPU/CHR) and port B (CPU/ROM) to the
// core via tango_core_ports.vh.  Use with TANGO_VIDEO_ASCAL; mutually exclusive with TANGO_SDRAM.
// Port interface is identical to sdram_nes.v (addrA/B, oeA/B, weA/B, dinA/B, doutA/B, clkref, busy).

// TANGO_VIDEO_OPTS: the core opts in to the framework's Video options (tango_video_opts.vh): Aspect ratio
// (status[127:126]), Scale (status[125:124]) and Scanlines (status[123:122]) are entries the core puts in its
// CONF_STR with `TANGO_VIDEO_CONF / `TANGO_VIDEO_CONF_P, decoded by tango_video.v; the core outputs its native
// VIDEO_ARX/ARY and 0 on VIDEO_SCALE and VGA_SL. The framework's full reserved range is status[127:118] (sys/
// tango_video_opts.vh TANGO_VO_HI/LO): status[121:120] stays reserved for a future Filter entry, status[119:118] for
// Rotation -- Filter is still unimplemented; Rotation IS in `TANGO_VIDEO_CONF, but
// only for a build that also defines TANGO_VIDEO_ROTATE. Either way, a core's own CONF_STR/RTL must still stay
// clear of the whole byte, not just the live entries.  Needs TANGO_VIDEO_ASCAL (tango_sys refuses it without).
// build_core.sh TANGO_VIDEO_OPTS=1; sims +define+TANGO_VIDEO_OPTS.
// Not defined: the core drives VIDEO_ARX/ARY, VIDEO_SCALE and VGA_SL itself, and the build is as before.

// TANGO_VIDEO_PROC: MiSTer's video processing (README "Video and audio processing"): the scaler's polyphase filters (ascal's
// poly port, loaded over the link), gamma (tango_gamma.v, before the scaler) and the shadow mask (tango_shmask.v,
// after it).  Needs TANGO_VIDEO_ASCAL (tango_sys refuses it without).  Implies TANGO_AUDIO_FILTER.
// TANGO_AUDIO_FILTER: MiSTer's audio filter (tango_audio_filter.v: the IIR at the file's rate, the 48 kHz DC
// blocker) in front of the 48 kHz HDMI sampling; any core.  Both make tango_link hand its SYS bytes to
// tango_vproc_regs (TANGO_LINK_TAP).  build_core.sh TANGO_VIDEO_PROC=1 / TANGO_AUDIO_FILTER=1; sims -D....
// TANGO_PRESET_STATUS (128-bit value): the option word at power-up, until the firmware's first SET_STATUS.
// TANGO_VPROC_PRESET: a compiled-in set of filters / gamma / mask / audio filter (tango_vproc_preset.vh, made by
// build_tools/vproc_preset.py), loaded after reset; the firmware's loads replace it.  Both are build options for
// boards without the Tango firmware running (JTAG tests); a default build has neither.
// TANGO_VPROC_FRAC: ascal's FRAC in a TANGO_VIDEO_PROC build, i.e. 2^FRAC coefficient phases per set and FRAC bits
// of horizontal fraction: 8, MiSTer's (Template_MiSTer sys_top.v 735), with ascal's coefficient memories as block RAM
// (sys/ascal_ghdl/ascal_poly_bram.patch, ascal_fixed8.v + ascal_shim8.v).  Every other build keeps ascal_fixed.v
// (FRAC 4), byte for byte.
`ifdef TANGO_VIDEO_PROC
`ifndef TANGO_AUDIO_FILTER
`define TANGO_AUDIO_FILTER
`endif
`ifndef TANGO_VPROC_FRAC
`define TANGO_VPROC_FRAC 8
`endif
`endif
`ifdef TANGO_AUDIO_FILTER
`ifndef TANGO_LINK_TAP
`define TANGO_LINK_TAP
`endif
`endif
// TANGO_VSYNC_ADJUST (with TANGO_VIDEO_ASCAL; README "Native-rate video (vsync_adjust)"): native-rate output.  sys measures
// the core's frame period (its VGA_VS) and runs the HDMI raster at the totals H x V (H 1650..1720, V 740..790) closest to
// it at the unchanged 74.25 MHz pixel clock, re-planned when the core's rate changes (e.g. the TG16's 262 <-> 263 lines),
// switched at a frame boundary in every consumer (tango_vsync.v).  TANGO_VSYNC_DEFAULT: the mode after reset (1 native,
// 0 the fixed raster TANGO_HDMI_HTOTAL x _VTOTAL), until the firmware's SYS 0x70 (Tango.ini VSYNC_ADJUST) says otherwise.
// Needs the link tap, i.e. TANGO_VIDEO_PROC or TANGO_AUDIO_FILTER (the standard set; tango_sys refuses it without).
// build_core.sh TANGO_VSYNC_ADJUST=1 [TANGO_VSYNC_DEFAULT=0|1]; sims -D....
// Not defined: the raster is the fixed TANGO_HDMI_HTOTAL x _VTOTAL, every build as before.
`ifdef TANGO_VSYNC_ADJUST
`ifndef TANGO_VSYNC_DEFAULT
`define TANGO_VSYNC_DEFAULT 1
`endif
`endif

// TANGO_HDMI_HTOTAL / TANGO_HDMI_VTOTAL: the HDMI raster's totals in clk_pix (fixed at build time):
// the frame is HTOTAL x VTOTAL clocks of the unchanged 74.25 MHz pixel clock, so the output frame rate is
// 74.25e6 / (HTOTAL x VTOTAL) -- a core's native rate to a few ppm with a few pixels / lines more or less, no clock change.
// The active 1280 x 720 picture, the sync pulses (hdmi.sv: HSYNC at 1390-1429, VSYNC lines 724-729 from x 1390) and the
// data islands (x 1292-1615) stay where they are; the extra pixels / lines are back porch.  Every consumer of the raster
// takes the same pair: hdmi.sv (board top), tango_beam_lead (both leads), tango_menu_overlay, tango_video (the ascal
// output alignment) and ascal's o_htotal / o_vtotal (tango_sys.v).  Limits: HTOTAL 1626..1720 (the video preamble at
// HTOTAL-10 must follow the last data island, which ends at 1615; above 1720 nothing is gained), VTOTAL 740..790 (>= 10
// lines after VSYNC for ascal's two-line preload).  build_core.sh TANGO_HDMI_HTOTAL=<n>
// TANGO_HDMI_VTOTAL=<n> checks the range.  TANGO_HDMI_VIC: the AVI InfoFrame's VIC (4 = 1280x720p60, CEA-861; 0 = no
// VIC, for a non-CEA raster).  Not defined: 1650 x 750 and VIC 4, every build as before.
`ifndef TANGO_HDMI_HTOTAL
`define TANGO_HDMI_HTOTAL 1650
`endif
`ifndef TANGO_HDMI_VTOTAL
`define TANGO_HDMI_VTOTAL 750
`endif
`ifndef TANGO_HDMI_VIC
`define TANGO_HDMI_VIC 4
`endif

// TANGO_HDMI_PLL_<f>: the HDMI pixel clock retuned AT BUILD TIME, so that with the totals
// lever (above, or TANGO_VSYNC_ADJUST's live totals) a core's native rate is met to a few ppm.  pll_c1485 keeps its form --
// 27 MHz in, IDIV 1, ODIV0 4 (clk_ser = 5 x clk_pix, OSER10's 5:1), ODIV1 20, PLL_INIT's MULTI_FAC bucket "> 34" -- and only
// MDIV moves (integer + eighths: the form TANGO_HDMI_RETUNE switches at run time).  Everything coherent with clk_pix follows: the
// clk_audio accumulator (+AUD_INC mod AUD_MOD on clk_pix = EXACTLY 96 kHz toggles = 48 kHz), tango_audio_filter's 48 kHz
// strobe and its clock (S48_*: half the audio pair; FPIX), the ACR's N / CTS (HDMI 1.4b
// 7.2: CTS = f_pix x N / (128 x 48000), an integer), and the SDC's clk_pix / clk_ser periods (build_core.sh).  Presets:
//   TANGO_HDMI_PLL_745875  74.5875 MHz = 27 x (55 + 2/8) / 20, VCO 1491.75 MHz ("A": the TG16's 263 / 262-line frames at
//                          1669 x 747 -3.73 ppm / 1656 x 750 -1.69 ppm, one PLL for both); +64 mod 49725; N 12288, CTS 149175
//   TANGO_HDMI_PLL_75600   75.6 MHz = 27 x 56 / 20, VCO 1512 MHz ("B", integer MDIV; 1680 x 750 = 60.000 Hz exactly);
//                          +2 mod 1575; N 6144, CTS 75600
// build_core.sh TANGO_HDMI_PLL=745875|75600; sims -DTANGO_HDMI_PLL_<f>.  Not defined: 74.25 MHz = 27 x 55 / 20 (VCO 1485),
// +16 mod 12375, N 6144 / CTS 74250 (computed in audio_clock_regeneration_packet.sv as always), every build as before.
`ifndef TANGO_HDMI_MDIV                 // once per compilation unit (this file is included by many)
`ifdef TANGO_HDMI_PLL_745875
`define TANGO_HDMI_PLL_SET
`define TANGO_HDMI_MDIV      55
`define TANGO_HDMI_MDIV_FRAC 2
`define TANGO_HDMI_FPIX      74587500
`define TANGO_HDMI_AUD_W     16
`define TANGO_HDMI_AUD_INC   64
`define TANGO_HDMI_AUD_MOD   49725
`define TANGO_HDMI_S48_W     16
`define TANGO_HDMI_S48_INC   32
`define TANGO_HDMI_S48_MOD   49725
`define TANGO_HDMI_ACR_N     12288
`define TANGO_HDMI_ACR_CTS   149175
`define TANGO_HDMI_CTS12288  149175
`elsif TANGO_HDMI_PLL_75600
`define TANGO_HDMI_PLL_SET
`define TANGO_HDMI_MDIV      56
`define TANGO_HDMI_MDIV_FRAC 0
`define TANGO_HDMI_FPIX      75600000
`define TANGO_HDMI_AUD_W     11
`define TANGO_HDMI_AUD_INC   2
`define TANGO_HDMI_AUD_MOD   1575
`define TANGO_HDMI_S48_W     11
`define TANGO_HDMI_S48_INC   1
`define TANGO_HDMI_S48_MOD   1575
`define TANGO_HDMI_ACR_N     6144
`define TANGO_HDMI_ACR_CTS   75600
`define TANGO_HDMI_CTS12288  151200
`else
`define TANGO_HDMI_MDIV      55
`define TANGO_HDMI_MDIV_FRAC 0
`define TANGO_HDMI_FPIX      74250000
`define TANGO_HDMI_AUD_W     14
`define TANGO_HDMI_AUD_INC   16
`define TANGO_HDMI_AUD_MOD   12375
`define TANGO_HDMI_S48_W     14
`define TANGO_HDMI_S48_INC   8
`define TANGO_HDMI_S48_MOD   12375
`endif
`endif
// TANGO_HDMI_RETUNE (with TANGO_VSYNC_ADJUST and a TANGO_HDMI_PLL_<f> preset): the HDMI
// pixel clock switched AT RUN TIME between 74.25 MHz and the preset (tango_pll_retune, board top) by SYS 0x70's native bit
// (Tango.ini VSYNC_ADJUST): native = the preset + the live totals; fixed = 74.25 MHz and 1650 x 750 = exactly 60.000 Hz.
// pll_c1485 runs DYN_MDIV (MDIV from the fabric; both settings in PLL_INIT's "> 34" bucket); at configuration the PLL is
// at the preset if TANGO_VSYNC_DEFAULT is 1 (no retune in the default case), else at 74.25.  The ACR's N is 12288 for both
// (CTS 148500 / TANGO_HDMI_CTS12288, switched with the PLL), the clk_audio accumulator's pair likewise; the SDC is the
// preset's (the higher clock).  A retune re-locks the PLL (~18 ms): the clk_pix domain -- link, overlay, video, the core --
// pauses (its clock is gated off, nothing in it is reset; tango_pll_retune.v, board top), so the firmware sends SYS 0x70
// FIRST at core start and waits until the retune is over (reply bit 2).
// build_core.sh TANGO_HDMI_RETUNE=1; sims -DTANGO_HDMI_RETUNE.  Not defined: the PLL is static, every build as before.
`ifdef TANGO_HDMI_RETUNE
`ifndef TANGO_HDMI_PLL_SET
`define TANGO_HDMI_RETUNE_NEEDS_A_PRESET
`endif
`ifndef TANGO_VSYNC_ADJUST
`define TANGO_HDMI_RETUNE_NEEDS_VSYNC_ADJUST
`endif
`endif
