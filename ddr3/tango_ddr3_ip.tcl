# tango_ddr3_ip.tcl -- generate the Gowin DDR3 Memory Interface IP into the build (README "The DDR3 path").
# The IP's files are Gowin's (encrypted RTL and a plain gate-level .vo): they are generated by every build, never
# committed.  Configuration: Sipeed's DDR3 example for the board (its ddr_memory test,
# ddr3_memory_interface.ipc / gwmc_param.v): two x16 H5TQ4G63EFR as x32, 1:4, 400 MHz (DDR3-800), CL 6, CWL 5,
# tRFC 260 ns.  IP version 5.9 in V1.9.11.03 Education: create_ipc + set_property (read_ipc of V1.9.12's .ipc crashes
# gw_sh); generate_target has no -force here.  Called from a gw_sh project:  source .../tango_ddr3_ip.tcl;
# tango_ddr3_gen_ip <dir>  -> <dir>/ddr3_memory_interface/ddr3_memory_interface.v, added to the project.
proc tango_ddr3_gen_ip {dir} {
    create_ipc -name ddr3 -module_name DDR3_Memory_Interface_Top -file_name ddr3_memory_interface -dir $dir -force
    set_property -dict {CONFIG.User_Interface Controller CONFIG.Memory_Type Components CONFIG.Memory_Clock 400
        CONFIG.CLK_Ratio 1:4 CONFIG.Dq_Width 32 CONFIG.Dram_Width 16 CONFIG.Ecc false CONFIG.Row_Address 15
        CONFIG.Column_Address 10 CONFIG.Burst_Mode 8 CONFIG.Burst_Type SEQ CONFIG.CAS_Latency 6 CONFIG.CW_Latency 5
        CONFIG.Additive_Latency 0 CONFIG.Wrire_Recovery 6 CONFIG.Rtt_Nom 40 CONFIG.Rtt_Wr OFF CONFIG.Addr_Cmd_Mode 1T
        CONFIG.OUTPUT_DRV HIGH CONFIG.User_Refresh false CONFIG.tRTP_Period 7500 CONFIG.tRP_Period 15000
        CONFIG.tWTR_Period 7500 CONFIG.tRC_Period 55000 CONFIG.tRAS_Period 37500 CONFIG.tRCD_Period 15000
        CONFIG.tFAW_Period 40000 CONFIG.tRRD_Period 10000 CONFIG.tCKE_Period 10000 CONFIG.tREFI_Period 7800000
        CONFIG.tRFC_Period 260000 CONFIG.tDLLK 512} [get_ips DDR3_Memory_Interface_Top]
    report_property [get_ips DDR3_Memory_Interface_Top]
    generate_target [get_ips DDR3_Memory_Interface_Top]
}
